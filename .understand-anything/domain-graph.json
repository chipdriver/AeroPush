    {
      "id": "domain:firmware-runtime",
      "type": "domain",
      "name": "固件启动与任务调度",
      "summary": "负责从 STM32 入口进入 AeroPush 应用层，创建 FreeRTOS 任务、队列、互斥锁和事件组，并启动调度器。InitTask 在调度开始后完成一次性外设和服务初始化。",
      "tags": [
        "startup",
        "freertos",
        "runtime"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "main",
          "APP_Main",
          "InitTask",
          "FreeRTOS objects"
        ],
        "businessRules": [
          "所有队列、互斥锁和事件组必须在调度器启动前创建",
          "InitTask 完成一次性初始化后删除自身"
        ],
        "crossDomainInteractions": [
          "启动 IMU、A7670E 串口、状态位和 LED 服务"
        ]
      }
    },
    {
      "id": "domain:attitude-sensing",
      "type": "domain",
      "name": "IMU 姿态采集与融合",
      "summary": "负责获取 MPU9250 和 AK8963 数据，按磁力计有效性选择九轴或六轴 Mahony 融合，并发布最新欧拉角。当前配置启用真实 MPU9250，模拟姿态分支仍作为回退工具保留。",
      "tags": [
        "imu",
        "mpu9250",
        "mahony"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "MPU9250",
          "AK8963",
          "AttitudeData_t",
          "qAttitude"
        ],
        "businessRules": [
          "qAttitude 长度为 1，只保留最新姿态",
          "磁力计不可用时退回六轴融合",
          "当前 APP_IMU_SOURCE_MODE 为 APP_IMU_SOURCE_REAL"
        ],
        "crossDomainInteractions": [
          "向遥测流程提供横滚角、俯仰角和航向角"
        ]
      }
    },
    {
      "id": "domain:positioning",
      "type": "domain",
      "name": "GNSS 定位更新",
      "summary": "负责驱动 A7670E GNSS 上电、查询定位响应并解析经纬度，然后覆盖发布最新定位。当前配置启用真实 GNSS，模拟轨迹构造函数仍保留用于联调。",
      "tags": [
        "gnss",
        "a7670e",
        "location"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "GnssData_t",
          "qGnss",
          "CGNSSPWR",
          "CGPSINFO"
        ],
        "businessRules": [
          "真实 GNSS 必须确认 READY 后才能查询定位",
          "qGnss 长度为 1，只保留最新定位",
          "当前 APP_GNSS_SOURCE_MODE 为 APP_GNSS_SOURCE_REAL"
        ],
        "crossDomainInteractions": [
          "复用 A7670E 串口事务，向遥测流程提供定位数据"
        ]
      }
    },
    {
      "id": "domain:cellular-mqtt",
      "type": "domain",
      "name": "4G 网络与 MQTT 发布",
      "summary": "负责通过 A7670E AT 指令完成 LTE 注册、数据网络打开、MQTT 客户端连接和遥测消息发布。ModemTask 串行执行网络、MQTT、GNSS 和发布处理，避免多个消费者同时读取接收环形缓冲区。",
      "tags": [
        "a7670e",
        "lte",
        "mqtt"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "ModemTask",
          "MqttPublishMsg_t",
          "qMqttPublish",
          "A7670E"
        ],
        "businessRules": [
          "LTE 注册成功后才能打开数据网络",
          "4G 网络就绪后才能初始化 MQTT",
          "AT 响应由 ModemTask 路径串行消费"
        ],
        "crossDomainInteractions": [
          "消费遥测发布队列，依赖 A7670E 串口传输"
        ]
      }
    },
    {
      "id": "domain:modem-transport",
      "type": "domain",
      "name": "A7670E 串口传输",
      "summary": "负责 USART1 初始化、接收中断写入环形缓冲区，以及任务侧逐字节读取 AT 响应。它是 GNSS、LTE 和 MQTT 共用的底层传输通道。",
      "tags": [
        "uart",
        "ring-buffer",
        "a7670e"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "USART1",
          "RX ring buffer",
          "BSP_A7670E_Uart_IRQHandler"
        ],
        "businessRules": [
          "中断只写环形缓冲区，任务侧负责消费",
          "环形缓冲区满时置位溢出标志并丢弃当前字节"
        ],
        "crossDomainInteractions": [
          "承载 GNSS、LTE 和 MQTT 的 AT 指令与响应"
        ]
      }
    },
    {
      "id": "domain:telemetry-status",
      "type": "domain",
      "name": "遥测组包与运行状态",
      "summary": "负责从姿态和 GNSS 最新值队列构造 JSON 遥测消息，并维护运行状态位与 LED 灯语。遥测队列把数据生产与 A7670E 发布节奏解耦。",
      "tags": [
        "telemetry",
        "status",
        "led"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "TelemetryTask",
          "AppStatus",
          "LedTask",
          "qMqttPublish"
        ],
        "businessRules": [
          "姿态和 GNSS 均无效时不发送空遥测",
          "qMqttPublish 长度为 4，用于缓冲待发布消息",
          "LED 灯语由校准状态驱动"
        ],
        "crossDomainInteractions": [
          "读取传感器与定位数据，向 MQTT 发布流程交付消息"
        ]
      }
    },
